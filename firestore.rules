rules_version = '2';

// 근력학교 Firestore 보안 규칙 (Phase B 잠금 + Phase C 평문 제거 전제)
//
// 목표: 비인증(토큰 없는 공격자)의 전체 DB 덤프를 차단한다.
// 전제: Phase A(서버 로그인 + signInWithCustomToken)가 배포되어 실사용자가
//       request.auth 를 채운 상태여야 한다. 클레임 = { isCoach:boolean, name:string }.
//
// ⚠️ 배포 순서 의존: users 를 인증 사용자 broad read 로 여는 것은
//    평문 password 필드가 제거된(Phase C) 뒤라야 안전하다.
//    → drop-plaintext-passwords 실행 후 이 규칙을 배포할 것.
//
// 2026-06-28 스코핑에서 발견한 락아웃 벡터 4개를 카브아웃했다:
//  1) users broad read (게시판 티어/학년 뱃지 getDocs) — 평문 제거 후 signedIn read 허용
//  2) 비로그인 신규등록 funnel — disabledClasses/entranceClasses/registrationFAQ/newStudentRegistrations 공개
//  3) 컨텍스트 마운트가 로그인 전 holidays 읽음 — holidays 공개 read
//  4) 로그인 폴백의 비인증 users read — Phase C에서 폴백 제거되므로 규칙에서 열지 않음

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isCoach()  { return signedIn() && request.auth.token.isCoach == true; }
    function isSelf(name) { return signedIn() && request.auth.token.name == name; }

    // ── 서버 전용: 비번 해시. 클라이언트 전면 차단(Admin SDK만 우회) ──
    match /userSecrets/{name} {
      allow read, write: if false;
    }

    // ── 계정: 인증 사용자 broad read(게시판 뱃지 getDocs). ──
    // 쓰기: 코치는 전체. 본인은 자기 문서에 티어/학년/PR플래그 등은 갱신하되 isCoach(권한)만 못 건드림.
    //   (refreshStudentTier/refreshStudentXP/PR축하플래그 소비가 본인 users 문서에 merge 씀)
    match /users/{name} {
      allow read: if signedIn();
      allow create, delete: if isCoach();
      allow update: if isCoach() ||
        (isSelf(name) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isCoach']));
    }

    // ── 비로그인 신규등록 funnel + 컨텍스트 마운트: 공개 read ──
    // holidays: GoogleSheetsProvider가 로그인 전 마운트에서 fetchHolidays()로 읽음 (막으면 앱 초기화 실패)
    match /holidays/{id}        { allow read: if true; allow write: if isCoach(); }
    match /disabledClasses/{id} { allow read: if true; allow write: if isCoach(); }
    match /entranceClasses/{id} { allow read: if true; allow write: if isCoach(); }
    match /registrationFAQ/{id} { allow read: if true; allow write: if isCoach(); }
    // 월별 모집 설정은 공개 조회, 코치만 수정. 미설정 월은 접수하지 않는다.
    match /recruitmentMonths/{month} {
      allow read: if true;
      allow create, update: if isCoach() && month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && request.resource.data.month == month
        && request.resource.data.status in ['open', 'inquiry', 'closed']
        && request.resource.data.keys().hasOnly(['month', 'status', 'notice', 'inquiryPhone', 'updatedAt'])
        && request.resource.data.notice is string && request.resource.data.notice.size() <= 300
        && request.resource.data.inquiryPhone is string;
      allow delete: if isCoach();
    }

    function admissionDateAllowed(date, month) {
      let today = request.time + duration.value(9, 'h');
      let parts = date.split('-');
      return date.matches(month + '-(0[1-9]|[12][0-9]|3[01])')
        && (int(parts[0]) > today.year() || (int(parts[0]) == today.year()
          && (int(parts[1]) > today.month() || (int(parts[1]) == today.month() && int(parts[2]) >= today.day()))));
    }
    function selectedEntranceAllowed(data) {
      let path = /databases/$(database)/documents/entranceClasses/$(data.entranceClassId);
      return exists(path) && get(path).data.isActive == true && get(path).data.get('closed', false) == false
        && get(path).data.get('currentCount', 0) < get(path).data.maxCapacity
        && data.entranceDate == get(path).data.date
        && admissionDateAllowed(data.entranceDate, data.recruitmentMonth);
    }
    function publicRecruitmentAllowed() {
      let data = request.resource.data;
      return data.keys().hasAll(['recruitmentMonth', 'status', 'entranceInquiry', 'entranceClassId', 'entranceDate'])
        && data.recruitmentMonth is string && data.recruitmentMonth.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && data.status in ['pending', 'waitlist']
        && exists(/databases/$(database)/documents/recruitmentMonths/$(data.recruitmentMonth))
        && get(/databases/$(database)/documents/recruitmentMonths/$(data.recruitmentMonth)).data.status == 'open'
        && ((data.entranceInquiry == '' && data.entranceClassId is string && selectedEntranceAllowed(data))
          || (data.entranceClassId == null && data.entranceInquiry is string
            && admissionDateAllowed(data.entranceInquiry, data.recruitmentMonth)
            && data.entranceInquiryReason is string && data.entranceInquiryReason.size() > 0));
    }
    // 신규 신청 공개 조회는 기존 경로 유지. 생성은 열린 모집월만, 이후 공개 갱신은 접수 문자 결과만 허용.
    match /newStudentRegistrations/{id} {
      allow read: if true;
      allow create: if isCoach() || publicRecruitmentAllowed();
      allow update: if isCoach() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['smsLog', 'updatedAt']);
      allow delete: if isCoach();
    }

    // ── 게시판: 인증 사용자 read/write. 좋아요·soft delete 때문에 작성자 세분화는 후순위(YAGNI) ──
    match /posts/{postId} {
      allow read, create, update, delete: if signedIn();
      match /comments/{commentId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    // ── 코치 전용 비공개 메모(수강생별 코치 노트): 코치만 read/write ──
    // ⚠️ 아래 generic 목록에 'coachNotes' 를 넣지 말 것 — OR 시맨틱으로 학생 read 가 뚫린다.
    match /coachNotes/{docId} {
      allow read, write: if isCoach();
    }

    // 운영 설정/훈련일지에 배포하는 명단: 학생은 조회만 가능.
    match /lockedSlots/{id} { allow read: if signedIn(); allow write: if isCoach(); }
    match /studentMeta/{id} { allow read: if signedIn(); allow write: if isCoach(); }
    match /studentCountSnapshots/{id} { allow read: if signedIn(); allow write: if isCoach(); }

    // ── 운영 + 훈련일지 컬렉션: 인증 사용자 read/write, 비인증 전면 차단 ──
    // ponytail: 우선 signedIn 으로 개방(락아웃 0 최우선). 소유자 단위 강화는 악용 시 별도 과제.
    // ⚠️ userSecrets/users 는 이 목록에 없어야 함(있으면 OR 시맨틱으로 위 차단이 뚫림).
    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection in [
        'makeupRequests', 'holdingRequests', 'absenceRequests', 'waitlistRequests', 'makeupWaitlists',
        'coachPinnedMemos', 'pinnedMemos', 'renewalContracts', 'studentTerminations',
        'personalBests', 'monthlyStamps',
        'records', 'freeWorkoutAttendance', 'freeWorkoutRoster',
        'exercises', 'oneRMRecords', 'archivedMemos'
      ];
    }
  }
}
